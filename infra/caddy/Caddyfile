{
	admin off
	# TLS is terminated by the Cloudflare tunnel; Caddy only routes plain HTTP inside the homelab.
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3001
	}

	# Service-to-service hooks (api -> web) never come from outside.
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}
}
