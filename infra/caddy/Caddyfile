{
	admin off
	# TLS is terminated by the Cloudflare tunnel; Caddy only routes plain HTTP inside the homelab.
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3001
	}

	# Service-to-service hooks (api -> web) never come from outside.
	handle /internal/* {
		respond 404
	}

	# Umami tracker under neutral names on our own domain, so blocklists that know
	# its default paths don't drop the visits. Only these two routes are public.
	handle /m/p.js {
		rewrite * /script.js
		reverse_proxy {$UMAMI_UPSTREAM}
	}
	handle /m/e {
		rewrite * /api/send
		reverse_proxy {$UMAMI_UPSTREAM}
	}

	handle {
		reverse_proxy web:3000
	}
}
