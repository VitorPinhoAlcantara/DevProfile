# Copy to .env before running `docker compose up`.

# Public entrypoint (Caddy). 7635 is what the Cloudflare Zero Trust tunnel targets.
PUBLIC_PORT=7635
# Use 127.0.0.1 if cloudflared runs on this same host and the port should not be reachable from the LAN.
PUBLIC_BIND=0.0.0.0

POSTGRES_USER=devprofile
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devprofile
