# Copy to .env before running `docker compose up`.

# Public entrypoint (Caddy). 7635 is what the Cloudflare Zero Trust tunnel targets.
PUBLIC_PORT=7635
# Use 127.0.0.1 if cloudflared runs on this same host and the port should not be reachable from the LAN.
PUBLIC_BIND=0.0.0.0

# Public address of the site (the domain the Cloudflare tunnel serves).
SITE_URL=https://seu-dominio.com.br

# Secrets: generate each one with `openssl rand -base64 48`.
# APP_SECRET encrypts the 2FA secrets in the database; keep it stable or 2FA stops working.
APP_SECRET=
# Lets the api tell the site to refresh after an admin save.
REVALIDATE_TOKEN=

# Session cookie only over HTTPS. Set to false only to test the admin over plain http.
COOKIE_SECURE=true

# Visitor stats (Umami, separate project in ~/Code/production/umami).
# Website ID from its dashboard (Settings > Websites). Empty = no tracking.
UMAMI_WEBSITE_ID=
